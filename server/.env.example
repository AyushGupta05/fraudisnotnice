# Copy to .env and fill in. run.sh loads this file.
SCAMCHECK_TOKEN=change-me          # the app sends this in the X-Token header
PORT=5055
AWS_SENDER_ID=SCAMCHECK            # texts go through AWS End User Messaging using `aws login`
AWS_REGION=us-east-1
DRILL_WINDOW_HOURS=48              # an untouched drill counts as passed after this long
